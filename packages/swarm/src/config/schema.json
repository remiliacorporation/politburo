{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["names", "tiers", "claims", "review", "setup", "trackers"],
  "properties": {
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mob_species", "sprite_items"],
      "properties": {
        "mob_species": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passive", "neutral", "hostile", "boss"],
          "properties": {
            "passive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["audit", "research", "review", "status", "gather", "plan"],
              "properties": {
                "audit": {"$ref": "#/definitions/pool"},
                "research": {"$ref": "#/definitions/pool"},
                "review": {"$ref": "#/definitions/pool"},
                "status": {"$ref": "#/definitions/pool"},
                "gather": {"$ref": "#/definitions/pool"},
                "plan": {"$ref": "#/definitions/pool"}
              }
            },
            "neutral": {
              "type": "object",
              "additionalProperties": false,
              "required": ["build", "fix", "refactor", "sync", "port", "docs", "ci"],
              "properties": {
                "build": {"$ref": "#/definitions/pool"},
                "fix": {"$ref": "#/definitions/pool"},
                "refactor": {"$ref": "#/definitions/pool"},
                "sync": {"$ref": "#/definitions/pool"},
                "port": {"$ref": "#/definitions/pool"},
                "docs": {"$ref": "#/definitions/pool"},
                "ci": {"$ref": "#/definitions/pool"}
              }
            },
            "hostile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["integrate", "merge", "revert", "release", "raid", "cleanup"],
              "properties": {
                "integrate": {"$ref": "#/definitions/pool"},
                "merge": {"$ref": "#/definitions/pool"},
                "revert": {"$ref": "#/definitions/pool"},
                "release": {"$ref": "#/definitions/pool"},
                "raid": {"$ref": "#/definitions/pool"},
                "cleanup": {"$ref": "#/definitions/pool"}
              }
            },
            "boss": {"$ref": "#/definitions/pool"}
          }
        },
        "sprite_items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implement", "fix", "review", "verify", "research", "docs"],
          "properties": {
            "implement": {"$ref": "#/definitions/pool"},
            "fix": {"$ref": "#/definitions/pool"},
            "review": {"$ref": "#/definitions/pool"},
            "verify": {"$ref": "#/definitions/pool"},
            "research": {"$ref": "#/definitions/pool"},
            "docs": {"$ref": "#/definitions/pool"}
          }
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models"],
      "properties": {
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sprite"],
          "properties": {
            "sprite": {
              "type": "object",
              "additionalProperties": false,
              "required": ["thinking"],
              "properties": {"thinking": {"type": "string"}}
            }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hours", "reclaim_cooldown_minutes"],
      "properties": {
        "hours": {"type": "integer", "minimum": 1},
        "reclaim_cooldown_minutes": {"$ref": "#/definitions/count"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docs_only", "code"],
      "properties": {
        "docs_only": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_review"],
          "properties": {"model_review": {"type": "boolean"}}
        },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_rounds", "fix_rounds"],
          "properties": {
            "review_rounds": {"$ref": "#/definitions/count"},
            "fix_rounds": {"$ref": "#/definitions/count"}
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment"],
      "properties": {
        "environment": {"type": "string"}
      }
    },
    "trackers": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^(?!(?:__proto__|constructor)$)": {"$ref": "#/definitions/tracker"}}
    }
  },
  "definitions": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "pool": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "count": {"type": "integer", "minimum": 0},
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "precedence"],
      "properties": {
        "sources": {"$ref": "#/definitions/strings"},
        "precedence": {"$ref": "#/definitions/strings"}
      }
    }
  }
}
