<?xml version="1.0" encoding="UTF-8"?>
<!--
PLACEHOLDER: subcommand and flags are not built yet; confirm against packages/swarm when it lands; do not install this file until then.
secretary daemon. Runs as SECRETARY_USER; reads secretary.env under CONFIG_ROOT.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL_PREFIX}}.secretary</string>
  <key>UserName</key>
  <string>{{SECRETARY_USER}}</string>
  <key>GroupName</key>
  <string>{{SERVICE_GROUP}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{HOST_BIN}}/run-with-env.sh</string>
    <string>{{CONFIG_ROOT}}/secretary.env</string>
    <string>--</string>
    <string>{{NODE}}</string>
    <string>{{SWARM_CLI}}</string>
    <string>secretary</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{DATA_ROOT}}/secretary</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>{{LOG_ROOT}}/secretary.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_ROOT}}/secretary.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{SERVICE_PATH}}</string>
    <key>HOME</key>
    <string>{{HOME_ROOT}}/secretary</string>
  </dict>
</dict>
</plist>
