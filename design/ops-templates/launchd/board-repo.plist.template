<?xml version="1.0" encoding="UTF-8"?>
<!--
board-repo loopback board. Runs as BOARD_REPO_USER; reads board-repo.env under CONFIG_ROOT.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL_PREFIX}}.board-repo</string>
  <key>UserName</key>
  <string>{{BOARD_REPO_USER}}</string>
  <key>GroupName</key>
  <string>{{SERVICE_GROUP}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{HOST_BIN}}/run-with-env.sh</string>
    <string>{{CONFIG_ROOT}}/board-repo.env</string>
    <string>--</string>
    <string>{{NODE}}</string>
    <string>{{BOARD_CLI}}</string>
    <string>serve</string>
    <string>--swarm</string>
    <string>--no-inspect</string>
    <string>--dir</string>
    <string>{{DATA_ROOT}}/board-repo</string>
    <string>--port</string>
    <string>{{PORT_REPO}}</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{DATA_ROOT}}/board-repo</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>{{LOG_ROOT}}/board-repo.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_ROOT}}/board-repo.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{SERVICE_PATH}}</string>
    <key>HOME</key>
    <string>{{HOME_ROOT}}/board-repo</string>
  </dict>
</dict>
</plist>
